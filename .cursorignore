# Cursor indexing exclusions (gitignore syntax).
# Reduces noise and keeps secrets / runtime data out of AI context.
# Git commit rules live in .gitignore; keep the two aligned where it matters.

# dependencies & build output
node_modules/
.next/
out/
build/

# secrets — templates (.env.example etc.) stay indexed
.env
.env.*
!.env.example
!.env.sample
!.env.template

# local runtime & personal
data/
*.db
!docs.local/
.protected.local
.push-authorized
.claude/settings.local.json

# generated API reference HTML (sources: openapi*.yaml)
docs/design/Endpoint/index.html
docs/design/Endpoint/index-admin.html
