# ------------------------------------------------------------------------------
# OpenAI APIキー（サーバ側のみ。クライアントには絶対に露出させない）
OPENAI_API_KEY=sk-...

# セットアップ生成・チャット応答に使うテキストモデル（任意・既定あり）
OPENAI_TEXT_MODEL=gpt-4o

# Realtime API（コール）用モデル（任意・既定あり）
OPENAI_REALTIME_MODEL=gpt-realtime

# Realtimeの既定音声（役割別の指定が無い場合のフォールバック）
OPENAI_REALTIME_VOICE=alloy

# 役割ごとの声（GA音声名）。ユーザー=女性、上司/部下=男性。
OPENAI_VOICE_USER=marin
OPENAI_VOICE_MANAGER=ash
OPENAI_VOICE_DEV=cedar

# 入力ノイズリダクション（クリアさ・誤割り込み低減）。near_field=近接マイク/far_field=離れたマイク
OPENAI_NOISE_REDUCTION=near_field

# 通話のVAD（話者区切り検出）チューニング（任意・既定はPlayground準拠）
OPENAI_VAD_TYPE=server_vad       # server_vad もしくは semantic_vad
OPENAI_VAD_THRESHOLD=0.5         # 0.0〜1.0。低いほど拾いやすい（既定0.5）
OPENAI_VAD_PREFIX_MS=300         # 発話開始前に含める音声(ms)
OPENAI_VAD_SILENCE_MS=500        # この無音が続いたら発話終了とみなす(ms)
# OPENAI_VAD_EAGERNESS=low       # semantic_vad時のみ: low/medium/high

# Provider selection（未設定時は既定値）
AI_PROVIDER=openai
VOICE_PROVIDER=openai
STORE_PROVIDER=sqlite # sqlite か　postgres を入れる
AUTH_PROVIDER=none # or authjs ; detail is below ("#Auth.js variables" line).

# Allow anonymous access (AUTH_PROVIDER=none) in production. Off by default
# (production requires real auth). Set to true to run the anonymous demo in production.
# AUTH_ALLOW_ANONYMOUS=true

# Auth.js variables (set when AUTH_PROVIDER=authjs)
AUTH_SECRET=
AUTH_GOOGLE_ID=<本番用 OAuth クライアントの ID>
AUTH_GOOGLE_SECRET=<本番用 OAuth クライアントの Secret>
AUTH_URL=http://localhost:3000 # or https://deployed-app-URL.com Google OAuth 利用時は必須
# AUTH_DEBUG=true # 開発時のみ。秘密情報がログに出るので通常は off
# Register this redirect URI in Google Cloud Console (Auth.js canonical path):
# http://localhost:3000/api/auth/callback/google or http://deployed-app-URL.com/api/auth/callback/google
# Comma-separated email domains allowed for sign-in/register (optional)
AUTH_ALLOWED_EMAIL_DOMAINS=example-specific-company.com

# SQLite path（STORE_PROVIDER=sqlite のとき使用）
SQLITE_PATH=./data/demo.db

# PostgreSQL connection string（STORE_PROVIDER=postgres のとき使用）
# POSTGRES_DATABASE_URL=postgres://user:pass@localhost:5432/airoleplay
