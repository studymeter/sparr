{
  "name": "airoleplay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "license-checker-rseidelsohn --production --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;BSD;0BSD;Unlicense;CC0-1.0;CC-BY-4.0;LGPL-3.0-or-later\" --excludePrivatePackages",
    "security:check": "npm run license:check",
    "prepare": "husky",
    "api:lint": "redocly lint",
    "api:docs": "redocly build-docs player -o docs/design/Endpoint/index.html && redocly build-docs admin -o docs/design/Endpoint/index-admin.html"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "html-to-image": "^1.11.13",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.2",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.34.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3"
  }
}
